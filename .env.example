# ---------------------------------------------------------------------------
# Frontend
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Server-side base URL used by the BFF proxy; points at the API inside Compose.
API_INTERNAL_BASE_URL=http://localhost:8000/api/v1

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=meg-lab-api
LOG_LEVEL=DEBUG
LOG_FORMAT=json
API_CORS_ORIGINS=http://localhost:3000
MAX_REQUEST_BODY_BYTES=1048576
DATABASE_URL=postgresql+psycopg://meglab:meglab@localhost:5433/meglab
DATABASE_POOL_MIN_SIZE=2
DATABASE_POOL_MAX_SIZE=16
DATABASE_CONNECT_TIMEOUT_SECONDS=5
DATABASE_STATEMENT_TIMEOUT_MS=15000
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/0
CELERY_TASK_TIME_LIMIT_SECONDS=300
CELERY_TASK_SOFT_TIME_LIMIT_SECONDS=280
JOB_LEASE_SECONDS=120
RUN_MAX_ATTEMPTS=3
OUTBOX_DISPATCH_MAX_ATTEMPTS=10
IDEMPOTENCY_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./.local-data/uploads
S3_ENDPOINT=
S3_BUCKET=meglab
S3_ACCESS_KEY=meglab
S3_SECRET_KEY=meglabminio123
S3_REGION=us-east-1

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# "development" enables the local POST /api/v1/auth/token endpoint.
# Production must use "oidc" and override AUTH_TOKEN_SECRET (or AUTH_PUBLIC_KEY).
AUTH_MODE=development
AUTH_TOKEN_SECRET=insecure-development-secret-change-me
# AUTH_PUBLIC_KEY=          # PEM public key for RS256/ES256 verification
AUTH_JWT_ALGORITHMS=HS256
AUTH_TOKEN_ISSUER=meg-lab
AUTH_TOKEN_AUDIENCE=meg-lab-api
AUTH_TOKEN_TTL_SECONDS=3600
# Session cookie for browser clients (HttpOnly)
AUTH_COOKIE_NAME=meg-lab_session
AUTH_COOKIE_SAMESITE=lax
# AUTH_COOKIE_SECURE=          # defaults to true in production, false otherwise
# AUTH_COOKIE_DOMAIN=          # defaults to a host-only cookie
# Development identity defaults (used only when AUTH_MODE=development)
DEV_IDENTITY_PROVIDER=local
DEV_IDENTITY_SUBJECT=demo-researcher
DEV_IDENTITY_DISPLAY_NAME=Demo Researcher
DEV_IDENTITY_EMAIL=demo@meg-lab.local
# Project seeded for a development user who belongs to none yet.
DEV_PROJECT_NAME=Development Project

# ---------------------------------------------------------------------------
# MEG-specific limits
# ---------------------------------------------------------------------------
MAX_UPLOAD_BYTES=1073741824
MAX_RECORDING_DURATION_S=3600
MAX_CHANNEL_COUNT=306
SAMPLING_RATE_MIN_HZ=100
SAMPLING_RATE_MAX_HZ=5000
UPLOAD_SESSION_TTL_SECONDS=3600