FROM python:3.14-slim

# Versioned scientific runtime image. Pinned by digest (MNE_WORKER_IMAGE) in
# pipeline provenance manifests; never referenced by mutable tag.
WORKDIR /srv

COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_COMPILE_BYTECODE=1 UV_LINK_MODE=copy PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-dev --no-install-project --extra bids

COPY app ./app
COPY workers ./workers

CMD ["celery", "-A", "workers.celery_app", "worker", "--loglevel=INFO"]
