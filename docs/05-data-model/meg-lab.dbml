Table idempotency_keys {
  key text [not null]
  user_id uuid [not null]
  request_hash text [not null]
  response_status integer [not null]
  response_body jsonb
  created_at timestamptz [not null, default: `now()`]
  expires_at timestamptz [not null]
  indexes {
    (key, user_id) [pk, name: 'pk_idempotency_keys']
    (expires_at) [name: 'ix_idempotency_keys_expires_at']
  }
  Note: 'Client-supplied idempotency keys for state-changing requests. Identical retries replay the stored response; a different request hash is a 409 conflict.'
}
